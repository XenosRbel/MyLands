{
  "description": "Realmforge shared agent harness",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/harness/harness.py\" hook", "timeout": 10}]}],
    "PreToolUse": [{"matcher": "^(Bash|Edit|Write|NotebookEdit|apply_patch)$", "hooks": [{"type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/harness/harness.py\" hook", "timeout": 10}]}],
    "PostToolUse": [{"matcher": "^(Edit|Write|NotebookEdit|apply_patch)$", "hooks": [{"type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/harness/harness.py\" hook", "timeout": 30}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/harness/harness.py\" hook", "timeout": 720}]}]
  }
}
