# Copy to .env (never commit real secrets). All settings are environment variables.
RF_ENV=development                 # development | test | production
RF_HTTP_ADDR=:8080
RF_DATABASE_URL=postgres://postgres@127.0.0.1:5432/realmforge?sslmode=disable
RF_PACKS_DIR=../packs
RF_CLIENT_DIR=../client/dist       # optional: serve the built client
RF_WORLDS=ember-1:ashen-crowns:Ember Vale:1,void-1:void-frontier:Void Frontier Demo:10
RF_WORKER=true                     # run the scheduled-event worker in this process
RF_WORKER_INTERVAL=1s
RF_SESSION_TTL=720h
RF_RATE_RPS=20
RF_RATE_BURST=60
RF_ALLOWED_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost
RF_ADMIN_LOGIN=                    # login promoted to admin at startup
RF_DEV_PLATFORM_AUTH=              # defaults true outside production; must be false in production
RF_METRICS_TOKEN=                  # protects /metrics; without it /metrics is disabled in production
RF_AUTO_MIGRATE_PACKS=             # default true outside production: upgrade RF_WORLDS worlds to the pack on disk when compatible
RF_TRUST_PROXY=                    # true only behind a trusted reverse proxy (X-Forwarded-For)
